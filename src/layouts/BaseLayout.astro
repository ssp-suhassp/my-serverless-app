---
import { withBase } from '../utils/basePath';

interface Props {
  title?: string;
  description?: string;
  coverImage?: string;
}

const {
  title = 'Git-Based Headless CMS',
  description = 'Local-First, Git-backed Headless CMS & Static Site Engine.',
  coverImage,
} = Astro.props;

const homeUrl = withBase('/');
const blogUrl = withBase('/blog');
const apiUrl = withBase('/api/posts.json');
const tagsUrl = withBase('/api/tags.json');
---

<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-900 text-slate-100">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {coverImage && <meta property="og:image" content={coverImage} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
  </head>
  <body class="min-h-full flex flex-col font-sans antialiased selection:bg-indigo-500 selection:text-white">
    <header class="border-b border-slate-800 bg-slate-900/90 backdrop-blur sticky top-0 z-50">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href={homeUrl} class="flex items-center gap-2 text-lg font-bold tracking-tight text-white hover:text-indigo-400 transition-colors">
          <span class="w-2.5 h-2.5 rounded-full bg-indigo-500 ring-4 ring-indigo-500/20"></span>
          <span>GitCMS Engine</span>
        </a>
        <nav class="flex items-center gap-6 text-sm font-medium">
          <a href={homeUrl} class="text-slate-300 hover:text-white transition-colors">Home</a>
          <a href={blogUrl} class="text-slate-300 hover:text-white transition-colors">Articles</a>
          <a href={apiUrl} target="_blank" rel="noopener noreferrer" class="px-2.5 py-1 rounded bg-slate-800 text-indigo-400 hover:bg-slate-700 hover:text-indigo-300 border border-slate-700 transition-colors">
            JSON API
          </a>
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-slate-800 bg-slate-950 mt-16 py-10 text-center text-sm text-slate-500">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
        <p>Built with Astro, Zod & GitHub Pages. Local-first & serverless.</p>
        <div class="flex items-center gap-4 text-xs">
          <a href={apiUrl} class="hover:text-slate-400 transition-colors">/api/posts.json</a>
          <span>•</span>
          <a href={tagsUrl} class="hover:text-slate-400 transition-colors">/api/tags.json</a>
        </div>
      </div>
    </footer>
  </body>
</html>

