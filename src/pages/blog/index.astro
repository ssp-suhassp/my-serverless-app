---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../utils/basePath';

const posts = await getCollection('posts', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

posts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<BaseLayout title="Articles | GitCMS Engine" description="Explore technical articles published via Serverless Headless CMS.">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-12">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">Articles</h1>
      <p class="text-slate-400 mt-2 text-base">
        All published articles stored in Git Markdown and served via GitHub Pages.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {posts.map((post) => (
        <article class="p-6 rounded-2xl bg-slate-800/40 border border-slate-700/60 hover:border-indigo-500/50 transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-3 text-xs text-slate-400 mb-3">
              <time datetime={post.data.date}>{post.data.date}</time>
              <span>•</span>
              <span>{post.data.author}</span>
              {post.data.draft && (
                <span class="px-2 py-0.5 rounded bg-amber-500/10 text-amber-400 border border-amber-500/20 text-[10px] font-semibold uppercase">
                  Draft
                </span>
              )}
            </div>
            <h2 class="text-xl font-bold text-white mb-2 hover:text-indigo-400 transition-colors">
              <a href={withBase(`/blog/${post.slug}`)}>{post.data.title}</a>
            </h2>
            <p class="text-slate-400 text-sm leading-relaxed mb-4">{post.data.excerpt}</p>
          </div>

          <div class="flex items-center justify-between pt-4 border-t border-slate-700/40">
            <div class="flex flex-wrap gap-2">
              {post.data.tags.map((tag) => (
                <span class="text-xs px-2 py-0.5 rounded bg-slate-700/60 text-slate-300">
                  #{tag}
                </span>
              ))}
            </div>
            <a
              href={withBase(`/blog/${post.slug}`)}
              class="text-xs font-semibold text-indigo-400 hover:text-indigo-300 inline-flex items-center gap-1"
            >
              Read article &rarr;
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
