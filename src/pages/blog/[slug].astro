---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { marked } from 'marked';
import { withBase, rewriteHtmlSubpaths } from '../../utils/basePath';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => {
    return import.meta.env.PROD ? !data.draft : true;
  });

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const rawHtml = await marked.parse(post.body || '');
const renderedHtml = rewriteHtmlSubpaths(rawHtml);
---

<BaseLayout
  title={`${post.data.title} | GitCMS`}
  description={post.data.excerpt}
  coverImage={post.data.coverImage ? withBase(post.data.coverImage) : undefined}
>
  <article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-8">
      <a
        href={withBase('/blog')}
        class="text-xs font-semibold text-indigo-400 hover:text-indigo-300 inline-flex items-center gap-1 mb-6"
      >
        &larr; Back to all articles
      </a>

      <div class="flex items-center gap-3 text-xs text-slate-400 mb-4">
        <time datetime={post.data.date}>{post.data.date}</time>
        {post.data.updated && <span>(Updated: {post.data.updated})</span>}
        <span>•</span>
        <span>By {post.data.author}</span>
        {post.data.draft && (
          <span class="px-2 py-0.5 rounded bg-amber-500/10 text-amber-400 border border-amber-500/20 font-semibold uppercase">
            Draft
          </span>
        )}
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight leading-tight mb-4">
        {post.data.title}
      </h1>

      <p class="text-lg text-slate-300 leading-relaxed italic border-l-2 border-indigo-500 pl-4 my-6">
        {post.data.excerpt}
      </p>

      <div class="flex flex-wrap gap-2 pt-2">
        {post.data.tags.map((tag) => (
          <span class="text-xs px-2.5 py-1 rounded-full bg-slate-800 text-slate-300 border border-slate-700">
            #{tag}
          </span>
        ))}
      </div>
    </div>

    {post.data.coverImage && (
      <div class="mb-10 rounded-2xl overflow-hidden border border-slate-800">
        <img
          src={withBase(post.data.coverImage)}
          alt={post.data.title}
          class="w-full h-auto object-cover max-h-96"
        />
      </div>
    )}

    <div
      class="text-slate-300 space-y-6 leading-relaxed [&>h1]:text-2xl [&>h1]:font-bold [&>h1]:text-white [&>h1]:mt-8 [&>h2]:text-xl [&>h2]:font-bold [&>h2]:text-white [&>h2]:mt-6 [&>ul]:list-disc [&>ul]:pl-6 [&>ol]:list-decimal [&>ol]:pl-6 [&>p]:leading-relaxed [&>blockquote]:border-l-2 [&>blockquote]:border-indigo-500 [&>blockquote]:pl-4 [&>blockquote]:italic [&>blockquote]:text-slate-400"
      set:html={renderedHtml}
    />

    <div class="mt-16 pt-8 border-t border-slate-800 flex items-center justify-between">
      <a
        href={withBase('/blog')}
        class="text-sm font-semibold text-indigo-400 hover:text-indigo-300 inline-flex items-center gap-1"
      >
        &larr; Back to all articles
      </a>
      <a
        href={withBase(`/api/posts/${post.slug}.json`)}
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs px-3 py-1.5 rounded bg-slate-800 text-slate-300 hover:text-white border border-slate-700"
      >
        View Headless JSON Payload
      </a>
    </div>
  </article>
</BaseLayout>
